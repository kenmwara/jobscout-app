    "kenya submit button": "#2fbd6a -> --action (green at control scale means auto)",
    "kenya page ground": "green runs full-bleed -> constrain to the .hero block",
    "hero period": "#ef4b3c is not a kit colour -> --unsure #ff6d39, or drop it"
  }
